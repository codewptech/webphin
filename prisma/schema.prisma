// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  auth0_id       String   @unique
  email          String
  name           String?
  picture        String?
  email_verified Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model InsightCategory {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  public_id       String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @unique
  slug_text       String
  description     String
  seo_title       String?
  seo_description String?
  published_at    DateTime? @db.Timestamptz(6)
  posts           Insight[]
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
}

model Insight {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  public_id       String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug_text       String
  summary         String
  body_markdown   String
  hero_url        String?
  category_id     String          @db.Uuid
  category        InsightCategory @relation(fields: [category_id], references: [id])
  published_at    DateTime?       @db.Timestamptz(6)
  home_order      Int?            @unique
  featured_order  Int?            @unique
  seo_title       String?
  seo_description String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)

  @@index([category_id])
  @@index([published_at])
}
